rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isGuardianOf(userId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(userId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/users/$(userId)).data.guardianIds;
    }

    match /emergency_audio/{userId}/{fileName} {
      allow read: if isOwner(userId) || isGuardianOf(userId);
      allow write: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}
