    final contacts = [
      'Mother - 071 123 4567',
      'Father - 077 987 6543',
      'Police - 119',
      'Ambulance - 1990',
    ];

    return Scaffold(
      appBar: AppBar(
        title: const Text('Emergency Contacts'),
        centerTitle: true,
      ),
      body: ListView.builder(
        padding: const EdgeInsets.all(16),
        itemCount: contacts.length,
        itemBuilder: (context, index) {
