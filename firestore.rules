rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isGuardianOf(userId) {
      return signedIn()
        && userExists(userId)
        && request.auth.uid in userDoc(userId).data.guardianIds;
    }

    function isSafemateOf(userId) {
      return signedIn()
        && userExists(userId)
        && request.auth.uid in userDoc(userId).data.safemateIds;
    }

    function immutableUserFieldsUnchanged() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          request.resource.data.role == resource.data.role
          || (
            !('role' in resource.data)
            && request.resource.data.role in ['safemate', 'guardian']
          )
        );
    }

    function selfUserUpdateKeysAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'role',
        'guardianIds',
        'safemateIds',
        'updatedAt',
        'fcmToken',
        'batteryLevel',
        'lastSeenAt',
        'lastLocationSyncAt',
        'isEmergencyActive',
        'emergencyContactName',
        'emergencyContactPhone'
      ]);
    }

    function linkedCounterpartyUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'guardianIds',
          'safemateIds',
          'updatedAt'
        ])
        && (
          request.auth.uid in resource.data.guardianIds
          || request.auth.uid in request.resource.data.guardianIds
          || request.auth.uid in resource.data.safemateIds
          || request.auth.uid in request.resource.data.safemateIds
        );
    }

    function alertReadAllowed(alertUserId, guardianIds) {
      return signedIn()
        && (
          request.auth.uid == alertUserId
          || request.auth.uid in guardianIds
          || isGuardianOf(alertUserId)
        );
    }

    function immutableAlertFieldsUnchanged() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.guardianIds == resource.data.guardianIds
        && request.resource.data.type == resource.data.type
        && request.resource.data.timestamp == resource.data.timestamp
        && request.resource.data.locationLat == resource.data.locationLat
        && request.resource.data.locationLng == resource.data.locationLng
        && request.resource.data.batteryLevel == resource.data.batteryLevel;
    }

    function alertUpdateKeysAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'title',
        'description',
        'audioUrl',
        'acknowledgedBy',
        'acknowledgedAt',
        'canceledByUser',
        'resolvedAt'
      ]);
    }

    match /users/{userId} {
      allow create: if isSelf(userId)
        && request.resource.data.id == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (
          !('role' in request.resource.data)
          || request.resource.data.role in ['safemate', 'guardian']
        );
      allow get, list: if isSelf(userId) || isGuardianOf(userId) || isSafemateOf(userId);
      allow update: if signedIn()
        && immutableUserFieldsUnchanged()
        && (
          (isSelf(userId) && selfUserUpdateKeysAllowed())
          || (!isSelf(userId) && linkedCounterpartyUpdateAllowed())
        );
      allow delete: if false;
    }

    match /medical_profiles/{userId} {
      allow create, update: if isSelf(userId)
        && request.resource.data.userId == request.auth.uid;
      allow get, list: if isSelf(userId) || isGuardianOf(userId);
      allow delete: if false;
    }

    match /settings/{userId} {
      allow create, update: if isSelf(userId)
        && request.resource.data.userId == request.auth.uid;
      allow get, list: if isSelf(userId) || isGuardianOf(userId);
      allow delete: if false;
    }

    match /geofences/{userId} {
      allow create, update: if isSelf(userId)
        && request.resource.data.userId == request.auth.uid;
      allow get, list: if isSelf(userId) || isGuardianOf(userId);
      allow delete: if isSelf(userId);
    }

    match /alerts/{alertId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in [
          'sos',
          'low_battery',
          'geofence',
          'missed_checkin',
          'manual_checkin'
        ]
        && request.resource.data.status in [
          'active',
          'resolved',
          'canceled'
        ];
      allow get, list: if alertReadAllowed(
        resource.data.userId,
        resource.data.guardianIds
      );
      allow update: if alertReadAllowed(
          resource.data.userId,
          resource.data.guardianIds
        )
        && immutableAlertFieldsUnchanged()
        && alertUpdateKeysAllowed();
      allow delete: if false;
    }

    match /checkins/{checkinId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow get, list: if signedIn()
        && (
          request.auth.uid == resource.data.userId
          || isGuardianOf(resource.data.userId)
        );
      allow update, delete: if false;
    }

    match /logs/{logId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow get, list: if signedIn()
        && (
          request.auth.uid == resource.data.userId
          || isGuardianOf(resource.data.userId)
        );
      allow update, delete: if false;
    }
  }
}
